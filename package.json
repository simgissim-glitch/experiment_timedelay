{
  "name": "ai-latency-experiment",
  "version": "0.1.0",
  "private": true,
  "description": "생성형 AI 응답 지연과 정보 검증 행동 연구를 위한 실험 웹앱",
  "scripts": {
    "dev": "node --watch server.js",
