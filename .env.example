# 기존 .env가 있다면 덮어쓰지 말고 필요한 항목만 확인하세요.
PORT=3000
# 로컬 기본값은 .env 전용. 배포 시 서버 설정 SERVER_ENV_SOURCE=platform 사용.
# Vercel은 플랫폼 변수를 자동 사용하며 로컬 .env로 대체하지 않습니다.
# SERVER_ENV_SOURCE=platform
# 연구자 검토 후에만 배포 플랫폼에서 true로 설정합니다. 현재는 false 유지.
RESEARCH_RELEASE_APPROVED=false
# 서버에서만 읽습니다. 실제 비밀키는 .env에 입력하세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# 테스트와 연구용 Supabase 프로젝트를 각각 생성하세요. 실제 .env는 덮어쓰지 마세요.
DB_ENV=test
TEST_DATABASE_URL=
DATABASE_URL=
# 원격 연결은 인증서 검증을 강제합니다. 로컬 테스트만 disable을 허용합니다.
DB_SSL_MODE=verify-full
# Supabase에서 내려받은 CA 인증서가 필요한 경우 프로젝트 기준 경로를 지정합니다.
DB_SSL_CA_FILE=
# HTTPS 배포 시 실제 서비스 Origin을 지정하세요. 마지막 /는 붙이지 않습니다.
APP_ORIGIN=http://localhost:3000
# 실제 연구 기준 확정 전에는 test 환경에서만 임시 적격성 확인을 허용합니다.
ELIGIBILITY_POLICY=development-only
# 검색 서비스 확정 전에는 빈 값으로 두세요. 지원 어댑터: brave
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_COUNTRY=KR
SEARCH_LANGUAGE=ko
SEARCH_RESULT_COUNT=10
# 연구자 로컬 분석 전용 읽기 권한 계정. 웹 서버는 이 연결을 사용하지 않습니다.
ANALYSIS_DATABASE_URL=
# 관리자 인증은 서버에서만 검증합니다. npm.cmd run admin:password로 scrypt 해시 생성.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# 환경별 별도 최소 권한 DB 계정: ai_latency_admin 역할 구성원.
# 참가자 앱 DB URL이나 ANALYSIS_DATABASE_URL로 자동 대체하지 않습니다.
TEST_ADMIN_DATABASE_URL=
ADMIN_DATABASE_URL=
